# ---------------------------------------------------------------------------
# AI Cost Governor — backend environment
# Copy to .env for local development. On Render, set these as env vars.
# ---------------------------------------------------------------------------

# Postgres in production; SQLite is fine locally.
# Render/Supabase postgres:// URLs are normalized automatically.
DATABASE_URL=sqlite:///./ai_cost_governor.db

# Signs admin dashboard JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Fernet key used to encrypt client provider API keys at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this makes already-stored provider keys unreadable.
ENCRYPTION_KEY=

# Upstash Redis for proxy rate limiting. Optional — omit and rate limiting is
# skipped rather than failing requests.
# REDIS_URL=rediss://default:<password>@<host>:<port>

# Comma-separated allowed browser origins for the dashboard.
# Any *.vercel.app origin is also permitted by default.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upstream provider endpoints — override only for testing or a gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Cap-utilization thresholds that raise alerts.
# ALERT_THRESHOLDS=0.8,0.9
