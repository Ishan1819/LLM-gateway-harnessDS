# ---------------------------------------------------------------------------
# AI Cost Governor — backend environment
# Copy to .env for local development. On Render, set these as env vars.
# ---------------------------------------------------------------------------

# Postgres in production; SQLite is fine locally.
# Render/Supabase postgres:// URLs are normalized automatically.
DATABASE_URL=sqlite:///./ai_cost_governor.db

# Signs admin dashboard JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Fernet key used to encrypt client provider API keys at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this makes already-stored provider keys unreadable.
ENCRYPTION_KEY=

# Upstash Redis for proxy rate limiting. Optional — omit and rate limiting is
# skipped rather than failing requests.
# REDIS_URL=rediss://default:<password>@<host>:<port>

# Comma-separated allowed browser origins for the dashboard.
# Any *.vercel.app origin is also permitted by default.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080


# Mock LLM endpoints (services/mock-llm) — no real provider keys needed.
OPENAI_BASE_URL=http://127.0.0.1:8099/v1
ANTHROPIC_BASE_URL=http://127.0.0.1:8099/v1
UPSTREAM_RETRIES=2
MOCK_LATENCY_MS=150

# Cap-utilization thresholds that raise alerts.
# ALERT_THRESHOLDS=0.8,0.9

# --- Distributed runtime ---
# Set REDIS_URL + USAGE_MODE=stream to publish usage events to Redis Streams.
# REDIS_URL=redis://127.0.0.1:6379/0
POD_NAME=
USAGE_MODE=sync
RATE_LIMIT_PER_MIN=600
USAGE_STREAM=acg:usage-events
USAGE_GROUP=usage-workers
LOCK_TTL_MS=30000
LOCK_WAIT_MS=15000
LEADER_TTL_MS=6000
ALERT_SCAN_INTERVAL_S=10
HEARTBEAT_TTL_S=10
GATEWAY_INTERNAL_URL=http://127.0.0.1:8000

# --- Postgres (used by docker-compose and the Kubernetes Secret) ---
POSTGRES_DB=ai_cost_governor
POSTGRES_USER=acg
POSTGRES_PASSWORD=change-me
